local function redownloadAllAudio()
    if not (writefile and isfile and getAsset and game.HttpGet) then
        SettingsStatusLabel.Text = "Executor lacks file/download APIs"
        return
    end
    ensureMusicFolder()
    RedownloadBtn.Active = false
    RedownloadBtn.Text = "REFRESHING..."
    SettingsStatusLabel.Text = "Clearing music cache..."
    for _, e in ipairs(EMOTES) do
        if e.AudioUrl and e.AudioName then
            local fn = musicFileName(e.AudioName)
            if isfile(fn) and delfile then pcall(function() delfile(fn) end) end
            e.LocalAudioId = nil
        end
    end
    local total, done = 0, 0
    for _, e in ipairs(EMOTES) do if e.AudioUrl and e.AudioName then total += 1 end end
    for _, e in ipairs(EMOTES) do
        if e.AudioUrl and e.AudioName then
            done += 1
            SettingsStatusLabel.Text = ("Refreshing %d/%d"):format(done, total)
            cacheAudioForEmote(e, true)
            task.wait()
        end
    end
    RedownloadBtn.Text = "REFRESH ALL MUSIC"
    RedownloadBtn.Active = true
    SettingsStatusLabel.Text = "Music cache refreshed"
    task.delay(2.0, function()
        if SettingsStatusLabel.Parent then SettingsStatusLabel.Text = "" end
    end)
end
