    btn.ZIndex = 62
    btn.Parent = parent
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0,8)
    local state = initial
    local function render()
        btn.Text = labelText .. "    " .. (state and "ON" or "OFF")
        Tween(btn, {
            BackgroundColor3 = state and Color3.fromRGB(22,22,22) or Color3.fromRGB(16,16,16),
            TextColor3 = Color3.fromRGB(200,200,200),
        }, 0.12)
    end
    btn.Activated:Connect(function()
        state = not state
        callback(state)
        render()
    end)
    render()
    return {
        Button = btn,
        Set = function(v)
            state = v
            callback(v)
            render()
        end
    }
end
