local function cacheAudioForEmote(e, forceRefresh)
    if not (e.AudioUrl and e.AudioName and getAsset and writefile and isfile) then
        return false
    end
    ensureMusicFolder()
    local fn = musicFileName(e.AudioName)
    local function resolveLocal()
        if not isfile(fn) then return false end
        for _ = 1, 3 do
            local ok, asset = pcall(function() return getAsset(fn) end)
            if ok and asset then
                e.LocalAudioId = asset
                return true
            end
            task.wait(0.12)
        end
        return false
    end
    if not forceRefresh and resolveLocal() then
        return true
    end
    if delfile and isfile(fn) then
        pcall(function() delfile(fn) end)
    end
    e.LocalAudioId = nil
    for attempt = 1, 3 do
        local okAudio, audio = pcall(function()
            return game:HttpGet(e.AudioUrl)
        end)
        if okAudio and type(audio) == "string" and #audio > 0 then
            local okWrite = pcall(function() writefile(fn, audio) end)
            if okWrite and resolveLocal() then
                return true
            end
        end
        task.wait(0.18 * attempt)
    end
    return false
end
