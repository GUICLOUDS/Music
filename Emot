        local floorCF = getFloorCFrame(hrp, 0.06)
        for i, ring in ipairs(rings) do
            updatePulsingDisk(ring, floorCF, t + i * 0.22, pulse, 1.5 + i * 0.2, 1.8 + i * 0.25)
        end

        for i, streak in ipairs(streaks) do
