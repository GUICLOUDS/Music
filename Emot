        }), Transparency = NumberSequence.new(0.25), Color = seqColor(c[1], c[2]),
    })

    return function(t, pulse)
        local torsoCF = getTorsoCFrame(hrp)
        core.CFrame = torsoCF
        light.Color = c[1 + (math.floor(t * 3) % 3)]
        light.Brightness = 0.8 + pulse * 5
