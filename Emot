local function StartCustomDirectFx(token, e, hrp)
    if not token or token.cancelled or not e or not e.DirectAnimation then return end
    if CUSTOM_FX_EXCLUDED[e.Name] then return end

    local builder = DIRECT_FX_BUILDERS[e.Name]
    if not builder then return end

    local ok, updater = pcall(function()
        return builder(token, e, hrp)
    end)
    if not ok or type(updater) ~= "function" then
        if token.customFxFolder then
            pcall(function() token.customFxFolder:Destroy() end)
            token.customFxFolder = nil
        end
        return
    end

    token.customFxConnection = RunService.Heartbeat:Connect(function()
        if token.cancelled or ActiveToken ~= token or not hrp or not hrp.Parent then return end

        local sound = CurrentSound
        local loudness = 0
        if sound then
            pcall(function()
                loudness = math.clamp((sound.PlaybackLoudness or 0) / 260, 0, 1)
            end)
        end

        -- Blend real audio amplitude with a deterministic beat pulse so the effects
        -- still feel alive on executors where PlaybackLoudness is unavailable.
        local clock = os.clock()
        local beat = (math.sin(clock * math.pi * 3.2) + 1) * 0.5
        local pulse = math.clamp(loudness * 0.78 + beat * 0.22, 0, 1)

        pcall(function()
            updater(clock, pulse)
        end)
    end)
    table.insert(token.connections, token.customFxConnection)
end

local function StopCustomDirectFx(token, fadeTime)
    if not token then return end
    if token.customFxConnection then
        pcall(function()
            token.customFxConnection:Disconnect()
        end)
        token.customFxConnection = nil
    end
    if token.customFxFolder then
        local folder = token.customFxFolder
        token.customFxFolder = nil
        task.delay(fadeTime or 0, function()
            pcall(function()
                if folder and folder.Parent then
                    folder:Destroy()
                end
            end)
        end)
    end
end

local function applySoundVolume(sound, baseVolume)
    if not sound then return end
    sound.Volume = math.clamp((baseVolume or 1) * MasterVolume, 0, 2)
end
local function fadeOutSound(sound, duration)
    if not sound or not sound.Parent then return end
    local start = sound.Volume
    TweenService:Create(sound, TweenInfo.new(duration or TRANSITION_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Volume = 0}):Play()
    task.delay(duration or TRANSITION_TIME, function()
        if sound and sound.Parent then sound:Destroy() end
        if CurrentSound == sound then CurrentSound = nil end
    end)
end
local function createLoadedSound(e)
    if not e or NoMusicEnabled then return nil end
    local function makeSound()
        if not e.LocalAudioId then return nil end
        local sound = Instance.new("Sound")
        sound.Name = "EmoteMusic_" .. tostring(e.AudioName or e.Name or "Audio")
        sound.SoundId = e.LocalAudioId
        sound.Looped = e.DirectAnimation == true
        sound.TimePosition = e.StartPos or 0
        sound.Parent = workspace
        return sound
    end
    local sound = makeSound()
    if not sound then
        cacheAudioForEmote(e, true)
        sound = makeSound()
    end
    if not sound then return nil end
    local loaded = sound.IsLoaded
    if not loaded then
        local done = false
        local conn
        conn = sound.Loaded:Connect(function()
            done = true
        end)
        local deadline = os.clock() + 1.35
        while not done and not sound.IsLoaded and os.clock() < deadline do
            task.wait(0.05)
        end
        pcall(function() conn:Disconnect() end)
        loaded = sound.IsLoaded or done
    end
    if not loaded and e.AudioUrl then
        pcall(function() sound:Destroy() end)
        e.LocalAudioId = nil
        if cacheAudioForEmote(e, true) then
            sound = makeSound()
            if sound then
                local done = false
                local conn = sound.Loaded:Connect(function() done = true end)
                local deadline = os.clock() + 1.5
                while not done and not sound.IsLoaded and os.clock() < deadline do
                    task.wait(0.05)
                end
                pcall(function() conn:Disconnect() end)
                loaded = sound.IsLoaded or done
            end
        end
    end
    if not loaded then
        pcall(function() if sound then sound:Destroy() end end)
        return nil
    end
    return sound
end
local function PlaySound(e, transition)
    CurrentSoundFadeToken += 1
    if CurrentSound then
        local oldSound = CurrentSound
        CurrentSound = nil
        if transition then
            fadeOutSound(oldSound, TRANSITION_TIME)
        else
            pcall(function() oldSound:Destroy() end)
        end
    end
    if NoMusicEnabled then return end
    if not e.LocalAudioId then
        cacheAudioForEmote(e, false)
    end
    if not e.LocalAudioId then return end
    local s = createLoadedSound(e)
    if not s then return end
    applySoundVolume(s, 1)
    if transition then
        s.Volume = 0
    end
    s:Play()
    if transition then
        TweenService:Create(
            s,
            TweenInfo.new(TRANSITION_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            {Volume = math.clamp(MasterVolume, 0, 2)}
        ):Play()
    end
    CurrentSound = s
    if not e.DirectAnimation then
        task.delay(e.Duration or 20, function()
            if s and s.Parent then s:Destroy() end
            if CurrentSound == s then CurrentSound = nil end
        end)
    end
end
