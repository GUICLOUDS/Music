local function cacheVinylImage(forceRefresh)
    if not (writefile and isfile and getAsset) then return false end
    ensureMusicFolder()
    if forceRefresh and delfile and isfile(VINYL_IMAGE_FILE) then
        pcall(function() delfile(VINYL_IMAGE_FILE) end)
    end
    if isfile(VINYL_IMAGE_FILE) then
        local ok, asset = pcall(function() return getAsset(VINYL_IMAGE_FILE) end)
        if ok and asset then
            VinylImageId = asset
            return true
        end
    end
    local ok, imageData = pcall(function()
        return game:HttpGet(VINYL_IMAGE_URL)
    end)
    if not ok or type(imageData) ~= "string" or #imageData == 0 then
        return false
    end
    local wrote = pcall(function()
        writefile(VINYL_IMAGE_FILE, imageData)
    end)
    if not wrote then return false end
    local okAsset, asset = pcall(function() return getAsset(VINYL_IMAGE_FILE) end)
    if okAsset and asset then
        VinylImageId = asset
        return true
    end
    return false
end
