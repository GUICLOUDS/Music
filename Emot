        local anim = Instance.new("Animation")
        anim.AnimationId = "http://www.roblox.com/asset/?version=" .. tostring(e.Version or 1) .. "&id=" .. tostring(e.AnimationId)
        local track
        local ok = pcall(function()
            track = hum:LoadAnimation(anim)
        end)
        anim:Destroy()
        if not ok or not track then
            CancelActiveEmote()
            return
        end
        token.directTrack = track
        table.insert(token.tracks, track)
        track.Priority = Enum.AnimationPriority.Action
        track.Looped = true
        if e.DirectAnimation then
            hum.AutoRotate = token.oldAutoRotate ~= nil and token.oldAutoRotate or true
        elseif e.MoveLock then
            hum.WalkSpeed = 0
            hum.JumpPower = 0
            hum.JumpHeight = 0
            hum.AutoRotate = false
            hum:Move(Vector3.zero, true)
        end
        StartDirectHeadCamera(token, hum, hrp, head)
        track:Play(0.12, 1, e.AnimationSpeed or 1)
        if e.Name == EYE_CLOSED_EMOTE then
            StartEyeClosedEffect(token, hrp)
        end
        if e.DirectAnimation and not CUSTOM_FX_EXCLUDED[e.Name] then
            StartCustomDirectFx(token, e, hrp)
        end
        PlaySound(e, true)
        return
    end
    PlaySound(e, true)
    local early = e.MusicEarly or 0
    task.spawn(function()
        local fallback = e.Duration or 30
        local elapsed = 0
        local interval = 0.1
        local waitedForTrack = 0
        while #token.tracks == 0 and not token.cancelled and waitedForTrack < 3 do
            task.wait(interval)
            waitedForTrack += interval
        end
        if token.cancelled then return end
        if #token.tracks == 0 then
            task.wait(math.max(0, fallback - waitedForTrack))
            if ActiveToken == token then
                IsEmoting = false
                EmoteOrigin = nil
            end
            return
        end
        while not token.cancelled and elapsed < fallback do
            task.wait(interval)
            elapsed += interval
            local anyPlaying = false
            for _, trk in ipairs(token.tracks) do
                if trk and trk.IsPlaying then
                    anyPlaying = true
                    break
                end
            end
            if not anyPlaying then break end
        end
        if ActiveToken == token and not token.cancelled then
            IsEmoting = false
            EmoteOrigin = nil
        end
    end)
    task.delay(early, function()
        if token.cancelled then return end
        local code = ScriptCache[e.Name]
        if code then
            task.spawn(function()
                local fn = loadstring(code)
                if fn then
                    setfenv(fn, createSpoofedEnv(fn, token))
                    pcall(fn)
                    if animator then
                        for _, playingTrack in ipairs(animator:GetPlayingAnimationTracks()) do
                            pcall(function() playingTrack.Priority = Enum.AnimationPriority.Action4 end)
                        end
                    end
                end
            end)
        else
            task.spawn(function()
                while not ScriptCache[e.Name] and not token.cancelled do task.wait(0.05) end
                if token.cancelled then return end
                local fn = loadstring(ScriptCache[e.Name])
                if fn then
                    setfenv(fn, createSpoofedEnv(fn, token))
                    pcall(fn)
                end
            end)
        end
    end)
end
