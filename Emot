        if limb then trailParts[#trailParts + 1] = addLimbTrail(folder, limb, c, 0.34, 1.0, 0.55) end
    end

    local streaks = {}
    for i = 1, 7 do
        local streak = addFxPart(folder, Vector3.new(0.09, 0.09, 3.2 + i * 0.4), c[(i % 3) + 1], 0.18)
        streaks[i] = streak
    end

