local function makeSlider(parent, y, minV, maxV, initialV, formatter, callback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1,-32,0,42)
    row.Position = UDim2.new(0,16,0,y)
    row.BackgroundTransparency = 1
    row.ZIndex = 61
    row.Parent = parent
    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(0.58,0,0,18)
    title.Position = UDim2.new(0,0,0,0)
    title.BackgroundTransparency = 1
    title.Font = Enum.Font.GothamSemibold
    title.TextSize = 10
    title.TextColor3 = Color3.fromRGB(205,205,205)
    title.Text = formatter and formatter(initialV, true) or tostring(initialV)
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.ZIndex = 62
    title.Parent = row
    local value = Instance.new("TextLabel")
    value.Size = UDim2.new(0.42,0,0,18)
    value.Position = UDim2.new(0.58,0,0,0)
    value.BackgroundTransparency = 1
    value.Font = Enum.Font.GothamBold
    value.TextSize = 9
    value.TextColor3 = Color3.fromRGB(235,235,235)
    value.Text = formatter and formatter(initialV, false) or tostring(initialV)
    value.TextXAlignment = Enum.TextXAlignment.Right
    value.ZIndex = 62
    value.Parent = row
    local track = Instance.new("Frame")
    track.Size = UDim2.new(1,0,0,5)
    track.Position = UDim2.new(0,0,0,28)
    track.BackgroundColor3 = Color3.fromRGB(38,38,38)
    track.BorderSizePixel = 0
    track.ZIndex = 62
    track.Parent = row
    Instance.new("UICorner", track).CornerRadius = UDim.new(1,0)
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((initialV-minV)/(maxV-minV),0,1,0)
    fill.BackgroundColor3 = Color3.fromRGB(210,210,210)
    fill.BorderSizePixel = 0
    fill.ZIndex = 63
    fill.Parent = track
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1,0)
    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0,11,0,11)
    knob.AnchorPoint = Vector2.new(0.5,0.5)
    knob.Position = UDim2.new((initialV-minV)/(maxV-minV),0,0.5,0)
    knob.BackgroundColor3 = Color3.fromRGB(245,245,245)
    knob.BorderSizePixel = 0
    knob.ZIndex = 64
    knob.Parent = track
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1,0)
    local drag = Instance.new("TextButton")
    drag.Size = UDim2.new(1,18,0,24)
    drag.Position = UDim2.new(0,-9,0,19)
    drag.BackgroundTransparency = 1
    drag.Text = ""
    drag.ZIndex = 65
    drag.Parent = row
    local current = initialV
    local function setValue(v)
        current = math.clamp(v, minV, maxV)
        local pct = (current-minV)/(maxV-minV)
        fill.Size = UDim2.new(pct,0,1,0)
        knob.Position = UDim2.new(pct,0,0.5,0)
        value.Text = formatter and formatter(current, false) or tostring(current)
        callback(current)
    end
    local function updateFromX(x)
        local left = track.AbsolutePosition.X
        local width = math.max(track.AbsoluteSize.X,1)
        setValue(minV + math.clamp((x-left)/width,0,1)*(maxV-minV))
    end
    drag.Activated:Connect(function()
        SettingsDragging = drag
        updateFromX(UserInputService:GetMouseLocation().X)
    end)
    drag.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            SettingsDragging = drag
            if input.Position then updateFromX(input.Position.X) end
        end
    end)
    drag.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            if SettingsDragging == drag then SettingsDragging = nil end
        end
    end)
    return {
        Row = row,
        Title = title,
        Value = value,
        Track = track,
        Fill = fill,
        Knob = knob,
        Set = setValue,
    }
end
