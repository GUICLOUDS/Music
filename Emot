local function seqColor(a, b)
    return ColorSequence.new({
        ColorSequenceKeypoint.new(0, a),
        ColorSequenceKeypoint.new(1, b),
    })
end

local function randUnit()
    local v = Vector3.new(
        math.random(-100, 100),
        math.random(-100, 100),
        math.random(-100, 100)
    )
    if v.Magnitude < 0.01 then
        return Vector3.new(0, 1, 0)
    end
    return v.Unit
end

local function getTorsoPart(hrp)
    local char = hrp and hrp.Parent
    if not char then return hrp end
    return char:FindFirstChild("UpperTorso")
        or char:FindFirstChild("Torso")
        or hrp
end

local function getTorsoCFrame(hrp)
    local torso = getTorsoPart(hrp)
    return torso and torso.CFrame or hrp.CFrame
end

local function getFloorCFrame(hrp, yOffset)
    local origin = (hrp and hrp.Parent and (hrp.Parent:FindFirstChild("UpperTorso") or hrp.Parent:FindFirstChild("Torso") or hrp))
    if not origin then return CFrame.new() end
    local pos = origin.Position
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {hrp.Parent}
    params.IgnoreWater = true
    local result = workspace:Raycast(pos + Vector3.new(0, 1.5, 0), Vector3.new(0, -14, 0), params)
    local floorY = result and result.Position.Y or (pos.Y - 3.0)
    return CFrame.new(pos.X, floorY + (yOffset or 0.08), pos.Z)
end

local function addFxPart(folder, size, color, transparency)
    local p = Instance.new("Part")
    p.Name = "FXPart"
    p.Size = size
    p.Transparency = transparency or 1
    p.Anchored = true
    p.CanCollide = false
    p.CanTouch = false
    p.CanQuery = false
    p.CastShadow = false
    p.Material = Enum.Material.Neon
    p.Color = color
    p.Parent = folder
    return p
end

local function addEmitter(parent, props)
    local pe = Instance.new("ParticleEmitter")
    for k, v in pairs(props) do
        pcall(function() pe[k] = v end)
    end
    pe.Parent = parent
    return pe
end

local function burstEmitter(pe, count)
    if pe and pe.Parent then
        pcall(function() pe:Emit(count or 8) end)
    end
end

-- Creates a medium, floor-locked pulsing energy disk. The light intensity is left
-- completely untouched; only the disk itself scales with the music pulse.
local function addPulsingDisk(folder, color, baseRadius, thickness, y, transparency)
    -- Medium ground-disk scale: keeps the pulse visible without overwhelming the character.
    baseRadius = baseRadius * 0.78
    local disk = addFxPart(folder, Vector3.new(thickness or 0.14, baseRadius * 2, baseRadius * 2), color, transparency or 0.16)
    disk.Name = "PulsingDisk"
    disk.Shape = Enum.PartType.Cylinder
    disk.Material = Enum.Material.Neon
    disk:SetAttribute("BaseRadius", baseRadius)
    disk:SetAttribute("BaseThickness", thickness or 0.14)
    disk:SetAttribute("BaseTransparency", transparency or 0.16)
    disk:SetAttribute("DiskY", y or 0.07)
    return disk
end

local function updatePulsingDisk(disk, floorCF, t, pulse, speed, expand)
    local baseRadius = disk:GetAttribute("BaseRadius") or 4
    local baseThickness = disk:GetAttribute("BaseThickness") or 0.14
    local diskY = disk:GetAttribute("DiskY") or 0.07
    local phase = t * (speed or 1.8)
    local wave = (math.sin(phase) + 1) * 0.5
    local radius = baseRadius + pulse * (expand or 0.95) + wave * 0.22
    disk.CFrame = floorCF * CFrame.Angles(0, t * (speed or 1.8), math.rad(90))
    disk.Size = Vector3.new(baseThickness + pulse * 0.08, radius * 2, radius * 2)
    local baseTransparency = disk:GetAttribute("BaseTransparency") or 0.16
    disk.Transparency = math.clamp(baseTransparency - pulse * 0.08, 0.035, 0.4)
end

local function addLimbTrail(folder, limb, colors, lifetime, width0, width1)
    if not limb or not limb:IsA("BasePart") then return nil end
    local top = Instance.new("Attachment")
    top.Name = "TrailTop"
    top.Position = Vector3.new(0, limb.Size.Y * 0.48, 0)
    top.Parent = limb

    local bottom = Instance.new("Attachment")
    bottom.Name = "TrailBottom"
    bottom.Position = Vector3.new(0, -limb.Size.Y * 0.48, 0)
    bottom.Parent = limb

    local trail = Instance.new("Trail")
    trail.Name = "EmoteLimbTrail"
    trail.Attachment0 = top
    trail.Attachment1 = bottom
    trail.Lifetime = lifetime or 0.32
    trail.MinLength = 0.02
    trail.FaceCamera = true
    trail.LightEmission = 1
    trail.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.05),
        NumberSequenceKeypoint.new(0.65, 0.22),
        NumberSequenceKeypoint.new(1, 1),
    })
    trail.WidthScale = NumberSequence.new({
        NumberSequenceKeypoint.new(0, width0 or 0.9),
        NumberSequenceKeypoint.new(0.55, width1 or 0.5),
        NumberSequenceKeypoint.new(1, 0),
    })
    trail.Color = seqColor(colors[1], colors[2])
    trail.Parent = folder
    trail.Destroying:Connect(function()
        pcall(function() top:Destroy() end)
        pcall(function() bottom:Destroy() end)
    end)
    return trail
end

local function pulsePart(part, baseSize, pulse)
    local s = math.clamp(0.82 + pulse * 0.55, 0.5, 1.55)
